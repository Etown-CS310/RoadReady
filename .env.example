# No quotes just the name
# Put your .env in the project root directory so where this file is
# Example:
# DB_NAME=roadready
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=

# Once .env has been made and the .sql has been run in the local XAMPP SQL server you should be able to run `node server/testsb.js`
# Go to `http://localhost:3001/testdb.html` click the buttons to run the tests, and everything *should* work.
