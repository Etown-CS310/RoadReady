# Copy this file to ".env" in the project root (same folder as package.json)
# and fill in your own values. Never commit ".env".
# Values are written WITHOUT quotes.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=roadready

PORT=3000

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Auto.dev API key for the estimated-vehicle-value card.
# Without it, vehicles with no stored value show "Unavailable".
AUTODEV_API_KEY=